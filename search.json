---
layout: null
sitemap: false
---
[
{%- for post in site.posts -%}
  {%- assign cat_slug = post.categories | first -%}
  {%- assign cat_info = site.data.categories | where: "slug", cat_slug | first -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "category": {{ cat_info.name | default: "" | jsonify }},
    "description": {{ post.description | default: "" | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
